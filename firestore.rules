rules_version = '2';

// Halterofilia · Selección — reglas de las fases 1 (cuentas y acceso), 2 (datos propios de cada atleta), 3 (plan anual) y 4 (semana asignada).
// Todo lo que no está permitido aquí queda prohibido.
// Fase 3: plan anual. Fase 4: semana asignada a cada atleta, sesiones cumplidas y ajuste de porcentajes (al final del archivo).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // El entrenador es quien figura en config/team. Ese documento se crea a mano desde la consola de Firebase,
    // así nadie puede declararse entrenador desde la app.
    function isCoach() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/team)
        && get(/databases/$(database)/documents/config/team).data.coachUid == request.auth.uid;
    }

    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function canReadPlan() { return isCoach() || isMember(); }

    // Quién es el entrenador. Solo lectura: no se puede escribir desde la app.
    match /config/team {
      allow read: if signedIn();
      allow write: if false;
    }

    // Atletas aprobados. Los crea el entrenador al aprobar; cada atleta puede leer solo el suyo.
    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isCoach());
      allow list: if isCoach();
      allow create, update: if isCoach()
        && request.resource.data.keys().hasOnly(['name', 'email', 'approvedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.approvedAt == request.time;
      allow delete: if isCoach();
    }

    // Datos propios (fase 2): sesiones, ejercicios con su máximo, perfil y plan semanal de cada atleta.
    // Un registro por documento: users/{uid}/records/{clave}. Solo escribe su dueño, y solo si está aprobado
    // (o es el entrenador). El entrenador puede leer los de todos (informes de la fase 4b).
    // Los registros no se borran de verdad: se marcan con del = true para avisar a los otros dispositivos.
    function isMemberOf(uid) { return exists(/databases/$(database)/documents/members/$(uid)); }
    // Quien entrena el plan: un atleta aprobado, o el entrenador con su propia cuenta (entrena la misma semana que el equipo,
    // pero no es miembro: no entra en las marcas ni en las comparaciones del equipo).
    function isTrainee(uid) { return isMemberOf(uid) || (isCoach() && request.auth.uid == uid); }
    match /users/{uid}/records/{key} {
      allow read: if signedIn() && ((request.auth.uid == uid && (isMemberOf(uid) || isCoach())) || isCoach());
      allow create, update: if signedIn() && request.auth.uid == uid && (isMemberOf(uid) || isCoach())
        && request.resource.data.keys().hasOnly(['t', 'd', 'u', 'del', 'at'])
        && request.resource.data.keys().hasAll(['t', 'u', 'at'])
        && request.resource.data.t in ['profile', 'plan', 'exercise', 'session']
        && request.resource.data.u is number
        && request.resource.data.u <= request.time.toMillis() + 600000
        && request.resource.data.at == request.time
        && (!('d' in request.resource.data) || (request.resource.data.d is string && request.resource.data.d.size() <= 300000))
        && (!('del' in request.resource.data) || request.resource.data.del is bool)
        && key.size() <= 120;
      allow delete: if false;
    }

    // Solicitudes de acceso. Cada persona crea la suya (con su propio correo y la hora del servidor).
    match /requests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isCoach());
      allow list: if isCoach();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      // El entrenador solo puede marcarla como rechazada
      allow update: if isCoach()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'rejected';
      // La persona puede retirar la suya (para volver a pedir acceso); el entrenador también
      allow delete: if signedIn() && (request.auth.uid == uid || isCoach());
    }

    // ---- Fase 3: plan anual ----

    // Plan que ven los atletas. Solo el entrenador lo cambia.
    match /config/plan {
      allow read: if canReadPlan();
      allow create, update: if isCoach()
        && request.resource.data.keys().hasOnly(['activePlanId', 'at'])
        && request.resource.data.activePlanId is string && request.resource.data.activePlanId.size() > 0 && request.resource.data.activePlanId.size() <= 60
        && request.resource.data.at == request.time;
      allow delete: if isCoach();
    }

    // Catálogo de ejercicios (inglés, español y los textos con que aparece en las planillas)
    match /exercises/{exId} {
      allow read: if canReadPlan();
      allow create, update: if isCoach()
        && request.resource.data.keys().hasOnly(['en', 'es', 'aliases'])
        && request.resource.data.en is string && request.resource.data.en.size() > 0 && request.resource.data.en.size() <= 120
        && request.resource.data.es is string && request.resource.data.es.size() <= 160
        && request.resource.data.aliases is list && request.resource.data.aliases.size() <= 40;
      allow delete: if isCoach();
    }

    // Planes: ficha, etapas y semanas. Cada año puede haber uno nuevo; los anteriores se conservan.
    match /plans/{planId} {
      allow read: if canReadPlan();
      allow create, update: if isCoach()
        && request.resource.data.keys().hasOnly(['name', 'year', 'format', 'stages', 'weeks', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow delete: if isCoach();

      match /stages/{stageId} {
        allow read: if canReadPlan();
        allow create, update: if isCoach()
          && request.resource.data.keys().hasOnly(['name', 'order'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 160 && request.resource.data.order is int;
        allow delete: if isCoach();
      }
      match /weeks/{weekId} {
        allow read: if canReadPlan();
        allow create, update: if isCoach()
          && request.resource.data.keys().hasOnly(['stageId', 'week', 'label', 'kind', 'notes', 'sessions', 'next'])
          && request.resource.data.week is int && request.resource.data.sessions is list && request.resource.data.sessions.size() <= 7
          && request.resource.data.next is string && request.resource.data.next.size() <= 40;
        allow delete: if isCoach();
      }
    }

    // ---- Fase 4: semana asignada, sesiones cumplidas y ajuste de porcentajes ----

    function weekOf(planId, weekId) { return get(/databases/$(database)/documents/plans/$(planId)/weeks/$(weekId)).data; }

    // La última sesión planificada de la semana debe estar cumplida (una semana de transición no la exige)
    function lastDone(uid, a) {
      let w = weekOf(a.planId, a.weekId);
      return w.kind == 'transition' || w.sessions.size() == 0
        || exists(/databases/$(database)/documents/users/$(uid)/completions/$(a.planId + '_' + a.weekId + '_' + string(w.sessions.size() - 1)));
    }

    // Semana que el entrenador le asigna a cada atleta. El atleta solo puede pasar a la semana siguiente:
    // después del corte (viernes 23:59 hora de Chile, calculado por la app) y con la última sesión cumplida.
    match /assignments/{uid} {
      allow get: if signedIn() && ((request.auth.uid == uid && isMemberOf(uid)) || isCoach());
      allow list: if isCoach();
      allow create, update: if isCoach()
        && request.resource.data.keys().hasOnly(['planId', 'weekId', 'week', 'stageId', 'weekEndsAt', 'setBy', 'at'])
        && request.resource.data.keys().hasAll(['planId', 'weekId', 'week', 'stageId', 'weekEndsAt', 'setBy', 'at'])
        && request.resource.data.planId is string && request.resource.data.planId.size() > 0 && request.resource.data.planId.size() <= 60
        && request.resource.data.weekId is string && request.resource.data.weekId.size() > 0 && request.resource.data.weekId.size() <= 40
        && request.resource.data.week is int && request.resource.data.stageId is string
        && request.resource.data.weekEndsAt is number
        && request.resource.data.setBy == request.auth.uid
        && request.resource.data.at == request.time
        && isTrainee(uid)
        && weekOf(request.resource.data.planId, request.resource.data.weekId).stageId == request.resource.data.stageId
        && weekOf(request.resource.data.planId, request.resource.data.weekId).week == request.resource.data.week;
      allow update: if signedIn() && request.auth.uid == uid && isTrainee(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['weekId', 'week', 'stageId', 'weekEndsAt', 'at'])
        && request.resource.data.at == request.time
        && request.time.toMillis() >= resource.data.weekEndsAt
        && weekOf(resource.data.planId, resource.data.weekId).next != ''
        && request.resource.data.weekId == weekOf(resource.data.planId, resource.data.weekId).next
        && request.resource.data.week == weekOf(resource.data.planId, request.resource.data.weekId).week
        && request.resource.data.stageId == weekOf(resource.data.planId, request.resource.data.weekId).stageId
        && request.resource.data.weekEndsAt >= resource.data.weekEndsAt + 597600000
        && request.resource.data.weekEndsAt <= resource.data.weekEndsAt + 612000000
        && lastDone(uid, resource.data);
      allow delete: if isCoach();
    }

    // Sesión cumplida: la crea el atleta al terminar una sesión del plan, con la hora del servidor, solo para
    // la semana que tiene asignada. No se puede editar ni borrar.
    match /users/{uid}/completions/{id} {
      allow read: if signedIn() && ((request.auth.uid == uid && isMemberOf(uid)) || isCoach());
      allow create: if signedIn() && request.auth.uid == uid && isTrainee(uid)
        && request.resource.data.keys().hasOnly(['planId', 'weekId', 'sessionIdx', 'completedAt'])
        && request.resource.data.keys().hasAll(['planId', 'weekId', 'sessionIdx', 'completedAt'])
        && request.resource.data.completedAt == request.time
        && request.resource.data.sessionIdx is int && request.resource.data.sessionIdx >= 0
        && exists(/databases/$(database)/documents/assignments/$(uid))
        && get(/databases/$(database)/documents/assignments/$(uid)).data.planId == request.resource.data.planId
        && get(/databases/$(database)/documents/assignments/$(uid)).data.weekId == request.resource.data.weekId
        && request.resource.data.sessionIdx < weekOf(request.resource.data.planId, request.resource.data.weekId).sessions.size()
        && id == request.resource.data.planId + '_' + request.resource.data.weekId + '_' + string(request.resource.data.sessionIdx);
      allow update, delete: if false;
    }

    // Ajuste de porcentajes (desde 90 %) de un atleta en una semana. Id: {uid}_{planId}_{weekId}.
    // Lo escribe el entrenador; el atleta solo lee el suyo.
    match /adjustments/{id} {
      allow read: if signedIn() && (isCoach() || (id.matches(request.auth.uid + '_.*') && isTrainee(request.auth.uid)));
      allow create, update: if isCoach()
        && request.resource.data.keys().hasOnly(['pcts', 'at'])
        && request.resource.data.pcts is map && request.resource.data.pcts.size() <= 400
        && request.resource.data.at == request.time;
      allow delete: if isCoach();
    }

    // Rutinas especiales: el entrenador arma una rutina propia (fuera del plan anual) para un atleta inscrito.
    // Cada sesión lista ejercicios con series, repeticiones, % del máximo y pausa en segundos.
    // La escribe solo el entrenador; el atleta lee únicamente las suyas (la consulta debe pedir uid == el suyo).
    match /routines/{rid} {
      allow read: if signedIn() && (isCoach() || (resource.data.uid == request.auth.uid && isMemberOf(request.auth.uid)));
      allow create, update: if isCoach()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'note', 'mode', 'sessions', 'setBy', 'at'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'sessions', 'setBy', 'at'])
        && (!('mode' in request.resource.data) || request.resource.data.mode in ['extra', 'replace'])
        && request.resource.data.uid is string && isMemberOf(request.resource.data.uid)
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 400))
        && request.resource.data.sessions is list && request.resource.data.sessions.size() >= 1 && request.resource.data.sessions.size() <= 14
        && request.resource.data.setBy == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if isCoach();
    }
  }
}
