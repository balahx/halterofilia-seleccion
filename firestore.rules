rules_version = '2';

// Halterofilia · Selección — reglas de la fase 1 (cuentas y acceso).
// Todo lo que no está permitido aquí queda prohibido.
// Las reglas de las fases siguientes (registros, plan, asignaciones) se agregarán en este mismo archivo.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // El entrenador es quien figura en config/team. Ese documento se crea a mano desde la consola de Firebase,
    // así nadie puede declararse entrenador desde la app.
    function isCoach() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/team)
        && get(/databases/$(database)/documents/config/team).data.coachUid == request.auth.uid;
    }

    // Quién es el entrenador. Solo lectura: no se puede escribir desde la app.
    match /config/team {
      allow read: if signedIn();
      allow write: if false;
    }

    // Atletas aprobados. Los crea el entrenador al aprobar; cada atleta puede leer solo el suyo.
    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isCoach());
      allow list: if isCoach();
      allow create, update: if isCoach()
        && request.resource.data.keys().hasOnly(['name', 'email', 'approvedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.approvedAt == request.time;
      allow delete: if isCoach();
    }

    // Solicitudes de acceso. Cada persona crea la suya (con su propio correo y la hora del servidor).
    match /requests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isCoach());
      allow list: if isCoach();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      // El entrenador solo puede marcarla como rechazada
      allow update: if isCoach()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'rejected';
      // La persona puede retirar la suya (para volver a pedir acceso); el entrenador también
      allow delete: if signedIn() && (request.auth.uid == uid || isCoach());
    }
  }
}
